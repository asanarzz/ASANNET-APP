<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/header_gradient"
        android:paddingHorizontal="12dp"
        android:paddingTop="28dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="ثبت آگهی"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="عنوان آگهی *"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edit_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/ads_input_bg"
                android:padding="12dp"
                android:hint="مثلاً: گوشی سامسونگ A54 سالم"
                android:inputType="text"
                android:maxLength="80"
                android:textColor="@color/text_main"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="دسته‌بندی *"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txt_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/ads_input_bg"
                android:padding="12dp"
                android:text="انتخاب دسته‌بندی"
                android:textColor="@color/text_muted"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="قیمت (تومان) — خالی بماند یعنی توافقی"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edit_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/ads_input_bg"
                android:padding="12dp"
                android:hint="مثلاً: 12000000"
                android:inputType="number"
                android:maxLength="15"
                android:textColor="@color/text_main"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="استان *"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txt_province"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/ads_input_bg"
                android:padding="12dp"
                android:text="انتخاب استان"
                android:textColor="@color/text_muted"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="شهر *"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txt_city"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/ads_input_bg"
                android:padding="12dp"
                android:text="ابتدا استان را انتخاب کنید"
                android:textColor="@color/text_muted"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="روستا (اختیاری)"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edit_village"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/ads_input_bg"
                android:padding="12dp"
                android:hint="اگر آگهی مربوط به روستاست، اسمش را بنویسید"
                android:inputType="text"
                android:maxLength="40"
                android:textColor="@color/text_main"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="شماره تماس"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edit_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/ads_input_bg"
                android:padding="12dp"
                android:hint="09123456789"
                android:inputType="phone"
                android:maxLength="15"
                android:textColor="@color/text_main"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="توضیحات *"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edit_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/ads_input_bg"
                android:padding="12dp"
                android:gravity="top"
                android:hint="وضعیت کالا، مشخصات، دلیل فروش و..."
                android:inputType="textMultiLine"
                android:minLines="4"
                android:maxLength="2000"
                android:textColor="@color/text_main"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="روش‌های ارتباط با شما"
                android:textColor="@color/text_main"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="شماره‌ی شما همیشه برای مدیر نمایش داده می‌شود، ولی برای بقیه‌ی کاربران فقط وقتی «تماس» یا «پیامک» را فعال کنید. حداقل یک روش را انتخاب کنید."
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/cb_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:buttonTint="@color/primary"
                android:checked="true"
                android:text="تماس تلفنی"
                android:textColor="@color/text_main"
                android:textSize="17sp" />

            <CheckBox
                android:id="@+id/cb_sms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/primary"
                android:checked="true"
                android:text="پیامک"
                android:textColor="@color/text_main"
                android:textSize="17sp" />

            <CheckBox
                android:id="@+id/cb_chat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/primary"
                android:checked="true"
                android:text="چت داخل برنامه"
                android:textColor="@color/text_main"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="آیدی ایتا (اختیاری)"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/edit_eitaa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/ads_input_bg"
                android:padding="12dp"
                android:hint="مثلاً: my_shop"
                android:inputType="textUri"
                android:maxLength="60"
                android:textColor="@color/text_main"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/txt_images_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="عکس‌ها"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btn_add_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:padding="12dp"
                android:background="@drawable/ads_input_bg"
                android:text="＋  افزودن عکس"
                android:textColor="@color/primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:id="@+id/scroll_thumbs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layout_images"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="آگهی شما بعد از بررسی و تأیید مدیر در برنامه نمایش داده می‌شود."
                android:textColor="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:paddingVertical="14dp"
                android:background="@drawable/ads_btn_bg"
                android:text="ثبت آگهی"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
