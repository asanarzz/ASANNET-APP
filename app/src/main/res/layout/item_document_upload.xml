<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="12dp"
    android:padding="14dp"
    android:background="@drawable/card_ripple">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txt_doc_index"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="۱"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:textSize="18sp"/>

        <LinearLayout
            android:id="@+id/btn_pick_file"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:padding="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_file"
                app:tint="@color/primary"/>

            <TextView
                android:id="@+id/txt_file_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/docs_pick_file"
                android:textColor="@color/text_muted"
                android:textSize="18sp"
                android:maxLines="1"
                android:textStyle="bold"
                android:ellipsize="middle"/>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_remove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textColor="@color/danger"
            android:textStyle="bold"
            android:textSize="20sp"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <EditText
        android:id="@+id/edit_doc_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/input_bg"
        android:padding="10dp"
        android:hint="@string/docs_document_note_hint"
        android:textColor="@color/text_main"
        android:textColorHint="@color/text_muted"
        android:textSize="17sp"
        android:textStyle="bold"
        android:minLines="1"/>

</LinearLayout>
