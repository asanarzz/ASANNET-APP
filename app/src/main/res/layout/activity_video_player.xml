<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- ویدیو: تمام صفحه، وسط -->
    <com.kafinet.asannet.FitVideoView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"/>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"/>

    <!-- نوار بالا: روی ویدیو قرار می‌گیرد و بعد از چند ثانیه مخفی می‌شود؛ با لمس صفحه دوباره دیده می‌شود -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#8C000000"
        android:padding="8dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"/>

        <TextView
            android:id="@+id/txt_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textColor="@color/white"
            android:textSize="19sp"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="ویدیوی آموزشی"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/btn_zoom"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_aspect_ratio"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/btn_rotate"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_screen_rotate"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/btn_cast"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_tv_cast"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"/>

        <ImageView
            android:id="@+id/btn_download"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_download"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null"/>
    </LinearLayout>

</FrameLayout>
